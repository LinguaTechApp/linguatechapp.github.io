---
import Layout from "../../layouts/Layout.astro";
---

<!-- Example: https://help.speak.com/en/ -->
<Layout>
  <div class="terms-container">
    <div class="terms-content">
      <h1>LinguaLoop Support</h1>

      <div class="intro">
        <p>
          Need help with LinguaLoop? Find answers quickly or reach out to our
          team below.
        </p>
      </div>

      <div class="quick-links">
        <p><strong>Quick links:</strong></p>
        <p>
          <a href="#frequently-asked-questions">FAQ</a> ·
          <a href="#contact-us">Contact Us</a> ·
          <a href="#legal-links">Legal</a>
        </p>
      </div>

      <hr />

      <div class="terms-section" id="frequently-asked-questions">
        <h2>Frequently Asked Questions</h2>

        <div class="faq-accordion">
          <div class="faq-item">
            <button
              class="faq-question"
              aria-expanded="false"
              aria-controls="faq-using-lingualoop"
            >
              <div class="faq-question-text">
                <span class="faq-symbol">📱</span>
                Using LinguaLoop
              </div>
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
            <div id="faq-using-lingualoop" class="faq-answer" hidden>
              <h3 id="languages-available">What languages are available?</h3>
              <p>
                Currently, we offer <strong>English</strong> and <strong
                  >Spanish</strong
                >.
              </p>

              <h3 id="change-language">How to change the language?</h3>
              <p>
                Tap the flag icon in the top left corner of the app. Select the
                language you want to use.
              </p>

              <h3 id="dictation-activities">
                What are dictation activities for?
              </h3>
              <p>
                Dictation activities are designed to help you improve your
                listening skills. You will hear a sentence or phrase and then
                choose the correct word from a randomized list of words.
              </p>

              <h3 id="quiz-activities">What are quiz activities for?</h3>
              <p>
                Quiz activities are designed to help you improve your listening
                skills. You will hear a short video fragment and then choose the
                correct answer from a randomized list of options.
              </p>

              <h3 id="create-account">How to create an account?</h3>
              <p>
                You can directly download the LinguaLoop app from the App Store.
                Upon opening the app, click <strong>Get Started</strong> and follow
                the prompts.
              </p>
              <p>
                Once your account is created, you're ready to log in and begin
                enhancing your listening skills.
              </p>

              <h3 id="supported-devices">What devices are supported?</h3>
              <p>LinguaLoop is supported on iOS 18.0 and later.</p>
              <p>Android is not supported yet. We're working on it.</p>

              <h3 id="curate-content">
                How does LinguaLoop curate the content?
              </h3>
              <p>
                We use a combination of AI and human curation to create the
                content. It's important to note that all content is reviewed by
                a human before it is published.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button
              class="faq-question"
              aria-expanded="false"
              aria-controls="faq-subscriptions-billing"
            >
              <div class="faq-question-text">
                <span class="faq-symbol">💳</span>
                Subscriptions & Billing
              </div>
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
            <div id="faq-subscriptions-billing" class="faq-answer" hidden>
              <h3 id="check-membership-status">
                How to check my membership status?
              </h3>
              <p>
                To check your membership status, tap the <strong>Profile</strong
                > icon in the bottom right corner of the app.
              </p>
              <p>
                There are three membership statuses: <strong>Free</strong>, <strong
                  >Premium</strong
                >, and <strong>Trial</strong>.
              </p>
              <p>
                If you're a premium member, you'll see your membership details
                and expiration date.
              </p>
              <p>
                Premium members have access to all features of the app,
                including all language activities.
              </p>
              <p>
                Free members have access to only the latest uploaded activity
                per mode (dictation and quiz) and language.
              </p>

              <h3 id="cancel-subscription">How do I cancel my subscription?</h3>
              <p>
                Open the app, go to <em
                  >Profile → Settings → Subscription → Manage Subscription →
                  Cancel Subscription</em
                >.
              </p>
              <p>Your access lasts until the current billing period ends.</p>

              <h3 id="plans">Plans &amp; Prices</h3>

              <p class="price-note" aria-label="App Store price information">
                LinguaLoop offers a monthly and an annual subscription plan. The
                exact price appears in the App Store purchase sheet before you
                confirm payment.
              </p>

              <p class="price-disclaimer" aria-label="Price disclaimer">
                <strong>Disclaimer:</strong>
                Prices may vary by region and are determined by the App Store. Subscriptions
                renew automatically unless cancelled in the App Store settings.
              </p>

              <h3 id="withdrawal-heading">14-Day Right of Withdrawal (EEA & UK)</h3>
              <p>
                If you reside in the European Economic Area or the United Kingdom, you have
                <strong>14 days from the purchase date</strong> to withdraw from your subscription
                without giving any reason. You can exercise this right by using Apple’s
                <a href="https://reportaproblem.apple.com/" rel="external nofollow">
                  “Report a Problem”
                </a>
                page or by contacting Apple Support directly.
                LinguaLoop cannot override refund decisions made by Apple.
              </p>

            </div>
          </div>

          <div class="faq-item">
            <button
              class="faq-question"
              aria-expanded="false"
              aria-controls="faq-account-sign-in"
            >
              <div class="faq-question-text">
                <span class="faq-symbol">👤</span>
                Account & Sign-In
              </div>
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
            <div id="faq-account-sign-in" class="faq-answer" hidden>
              <h3 id="sign-in-with-apple">Can I sign in with Apple?</h3>
              <p>
                Yes. Tap <strong>Continue with Apple</strong> on the login screen.
                Email login is available only for beta testers.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button
              class="faq-question"
              aria-expanded="false"
              aria-controls="faq-data-privacy"
            >
              <div class="faq-question-text">
                <span class="faq-symbol" role="img" aria-label="Data & Privacy"
                  >🔒</span
                >
                Data &amp; Privacy
              </div>

              <span class="faq-icon" aria-hidden="true">+</span>
            </button>

            <div id="faq-data-privacy" class="faq-answer" hidden>
              <h3 id="data-collected">What data do you collect?</h3>
              <p>
                We store your progress, preferred language, and basic device
                analytics. We <strong>never</strong> store raw audio or personal
                messages. See our <a href="/lingualoop/privacy-policy"
                  >Privacy&nbsp;Policy</a
                >
                for full details.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button
              class="faq-question"
              aria-expanded="false"
              aria-controls="faq-troubleshooting"
            >
              <div class="faq-question-text">
                <span class="faq-symbol">🔧</span>
                Troubleshooting
              </div>
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
            <div id="faq-troubleshooting" class="faq-answer" hidden>
              <h3 id="minimum-version">
                Is there a minimum required App & OS version to use LinguaLoop
                on mobile?
              </h3>
              <p>
                To see the minimum app and OS version, open the App Store
                listing and scroll to <strong>Compatibility</strong>.
              </p>
              <p>
                As always, we strongly encourage you to update the LinguaLoop
                app to the latest version to take advantage of the most recent
                features and improvements! If you're unable to load the app
                after an app update, please ensure to also update your OS
                version.
              </p>
              <h3 id="buffering-video">
                The video keeps buffering. What can I do?
              </h3>
              <p>
                First, check your network connection. If the problem persists,
                close the activity and reopen it.
              </p>
              <h3 id="poorly-worded-questions">
                I found poorly worded questions in Quiz activities. What can I
                do?
              </h3>
              <p>
                Tap the <button
                  class="report-issue"
                  aria-label="Report issue"
                  type="button"
                >
                  <span role="img" aria-label="Report issue">⚠️</span>
                </button> Report Issue button to report the issue. We'll review it
                and fix it as soon as possible. If you're not logged in, you'll be
                asked to log in first.
              </p>
              <h3 id="dictation-video-fragments">
                I found dictation activities where video fragments don't match
                the audio properly. What can I do?
              </h3>
              <p>
                Tap the <button
                  class="report-issue"
                  aria-label="Report issue"
                  type="button"
                >
                  <span role="img" aria-label="Report issue">⚠️</span>
                </button> Report Issue button to report the issue. We'll review it
                and fix it as soon as possible.
              </p>
              <h3 id="translate-text">
                The button for translating the text in the dictation activity
                doesn't work. What can I do?
              </h3>
              <p>
                Sometimes the first translation request needs an app relaunch
                when it's used for the first time. If the problem persists, tap
                the <button
                  class="report-issue"
                  aria-label="Report issue"
                  type="button"
                >
                  <span role="img" aria-label="Report issue">⚠️</span>
                </button>
                Report Issue button to report the issue. We'll review it and fix
                it as soon as possible.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="terms-section" id="contact-us">
        <h2>Contact Us</h2>
        <ul>
          <li>
            <strong>Email:</strong>
            <a href="mailto:support@linguatech.app">support@linguatech.app</a
            ><br />
            <em
              >We usually reply within <strong
                >24 hours (Monday – Friday)</strong
              >.</em
            >
          </li>

          <li>
            <strong>Phone:</strong> +54&nbsp;11&nbsp;6283-1134<br />
            <em>(Mon–Fri 09:00–17:00 ART / 12:00–20:00 UTC)</em>
          </li>

          <li>
            <strong>Postal address:</strong><br />
            Santa Marta 1906, Buenos Aires, C1650<br />
            Argentina
          </li>
        </ul>
      </div>

      <div class="terms-section" id="legal-links">
        <h2>Legal Links</h2>
        <p>
          <a href="/lingualoop/terms-of-use">Terms of Service</a> •
          <a href="/lingualoop/privacy-policy">Privacy Policy</a>
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .terms-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    margin-top: 2rem;
    margin-bottom: 2rem;
  }

  .terms-content {
    text-align: left;
  }

  h1 {
    font-size: 2.5rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 0.5rem;
    text-align: center;
  }

  .intro {
    background: #f8fafc;
    padding: 1.5rem;
    border-radius: 8px;
    border-left: 4px solid #3b82f6;
    margin-bottom: 2rem;
  }

  .intro p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: #374151;
  }

  .quick-links {
    margin-bottom: 2rem;
  }

  .quick-links p {
    font-size: 1rem;
    line-height: 1.6;
    color: #374151;
    margin-bottom: 0.5rem;
  }

  .quick-links strong {
    font-weight: 600;
    color: #111827;
  }

  hr {
    border: none;
    border-top: 2px solid #e5e7eb;
    margin: 2rem 0;
  }

  .terms-section {
    margin-bottom: 2rem;
    scroll-margin-top: 100px;
  }

  .terms-section h2 {
    font-size: 1.25rem;
    font-weight: 600;
    color: #111827;
    margin-bottom: 0.75rem;
    border-bottom: 2px solid #e5e7eb;
    padding-bottom: 0.5rem;
  }

  .terms-section h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: #111827;
    margin-bottom: 0.5rem;
    margin-top: 1.5rem;
  }

  .terms-section p {
    font-size: 1rem;
    line-height: 1.6;
    color: #374151;
    margin-bottom: 1rem;
  }

  .terms-section ul {
    margin: 0.5rem 0;
    padding-left: 1.5rem;
  }

  .terms-section ol {
    margin: 0.5rem 0;
    padding-left: 1.5rem;
  }

  .terms-section li {
    font-size: 1rem;
    line-height: 1.6;
    color: #374151;
    margin-bottom: 0.5rem;
  }

  .terms-section strong {
    font-weight: 600;
    color: #111827;
  }

  .terms-section em {
    font-style: italic;
    color: #6b7280;
  }

  .faq-accordion {
    margin-top: 1rem;
  }

  .faq-item {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    margin-bottom: 0.5rem;
    overflow: hidden;
  }

  .faq-item:last-child {
    margin-bottom: 0;
  }

  .faq-question {
    width: 100%;
    padding: 1rem 1.5rem;
    background: #f9fafb;
    border: none;
    text-align: left;
    font-size: 1.1rem;
    font-weight: 600;
    color: #111827;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: background-color 0.2s ease;
  }

  .faq-question-text {
    display: flex;
    align-items: center;
    flex: 1;
  }

  .faq-symbol {
    margin-right: 0.75rem;
    font-size: 1.2rem;
    opacity: 0.8;
  }

  .faq-question[aria-expanded="true"] .faq-symbol {
    opacity: 1;
  }

  .faq-question:hover {
    background: #f3f4f6;
  }

  .faq-question[aria-expanded="true"] {
    background: #3b82f6;
    color: white;
  }

  .faq-icon {
    font-size: 1.5rem;
    font-weight: 400;
    transition: transform 0.2s ease;
  }

  .faq-question[aria-expanded="true"] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
    background: white;
  }

  .faq-answer.expanded {
    max-height: 1000px;
    padding: 1rem 1.5rem;
  }

  .faq-answer p {
    margin-bottom: 1rem;
  }

  .faq-answer p:last-child {
    margin-bottom: 0;
  }

  .faq-answer ol {
    margin: 0.5rem 0;
    padding-left: 1.5rem;
  }

  .faq-answer li {
    font-size: 1rem;
    line-height: 1.6;
    color: #374151;
    margin-bottom: 0.5rem;
  }

  .contact-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 2px solid #e5e7eb;
    text-align: center;
  }

  .contact-section p {
    margin: 0;
    color: #6b7280;
    font-size: 0.9rem;
  }

  a {
    color: #3b82f6;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .terms-container {
      margin: 1rem;
      padding: 1.5rem 1rem;
    }

    h1 {
      font-size: 2rem;
    }

    .terms-section h2 {
      font-size: 1.1rem;
    }

    .terms-section h3 {
      font-size: 1rem;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Set aria-hidden on FAQ icons to prevent screen readers from announcing them
    document.querySelectorAll(".faq-icon").forEach((icon) => {
      icon.setAttribute("aria-hidden", "true");
    });

    const faqQuestions = document.querySelectorAll(".faq-question");

    faqQuestions.forEach((question) => {
      question.addEventListener("click", () => {
        const isExpanded = question.getAttribute("aria-expanded") === "true";
        const controlsId = question.getAttribute("aria-controls");
        const answer = controlsId
          ? document.getElementById(controlsId)
          : question.nextElementSibling;

        // Close all other FAQ items
        faqQuestions.forEach((otherQuestion) => {
          if (otherQuestion !== question) {
            otherQuestion.setAttribute("aria-expanded", "false");
            const otherControlsId = otherQuestion.getAttribute("aria-controls");
            const otherAnswer = otherControlsId
              ? document.getElementById(otherControlsId)
              : otherQuestion.nextElementSibling;
            if (otherAnswer) {
              otherAnswer.classList.remove("expanded");
              (otherAnswer as HTMLElement).hidden = true;
            }
          }
        });

        // Toggle current FAQ item
        question.setAttribute("aria-expanded", !isExpanded ? "true" : "false");
        if (answer) {
          answer.classList.toggle("expanded");
          (answer as HTMLElement).hidden = isExpanded; // Hide when closing, show when opening
        }
      });
    });
  });
</script>
