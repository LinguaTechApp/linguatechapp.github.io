---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<div class="container">
		<div class="content">
			<h1>Contact Us</h1>
			<p>
				Have questions about our products or want to learn more about how we can help with your language learning journey?
				We'd love to hear from you!
			</p>
			<p>
				Get in touch with us at: <a href="mailto:hello@linguatech.com" style="color: #3b82f6; text-decoration: none; font-weight: 600;">contact@linguatech.com</a>
			</p>
		</div>
	</div>
</Layout>

<style>
	.container {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: calc(100vh - 80px);
	}

	.content {
		text-align: center;
		max-width: 600px;
		padding: 2rem;
	}

	.content p {
		color: #7a7a7a;
		font-size: 1.25rem;
	}
</style>