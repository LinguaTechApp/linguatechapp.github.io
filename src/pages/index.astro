---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="container">
    <div class="content">
      <h1>LinguaTech</h1>
      <p>
        LinguaTech builds smart tools to help people learn languages through
        real, interactive content. We design with clarity, simplicity, and
        purpose.
      </p>
      <img
        src="/lingualoop-logo-512x512.png"
        alt="LinguaLoop Logo"
        class="logo"
      />
    </div>
  </div>
</Layout>

<style>
  .container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 80px);
  }

  .content {
    text-align: center;
    max-width: 600px;
    padding: 2rem;
  }

  .content p {
    color: #7a7a7a;
    font-size: 1.25rem;
  }

  .logo {
    max-width: 200px;
    width: 100%;
    height: auto;
  }
</style>
